# ===== クライアント公開可（VITE_ 接頭辞）=====
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_EMBEDDING_MODEL=Xenova/multilingual-e5-small

# 緊急キルスイッチ: false にすると全モードで cosine（類似度）のみになる（通常は true のまま）
VITE_FEATURE_LLM_LINKING=true

VITE_LINK_TOPK=6
# 注: multilingual-e5 は同言語の短文だと無関係でも cosine≈0.79 になるため、
#     cosine 単独結線のフロアは 0.80+ を推奨（分類器がいる場合は自動で recall 優先 0.40 に緩む）。
VITE_LINK_SIM_FLOOR=0.80

# --- lite（簡易版）のブラウザ内AI ---
# Tier2 標準: 多言語NLI（日本語対応・WASM・入室時自動プリロード ≈339MB→キャッシュ）
VITE_NLI_MODEL=Xenova/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
# 実測: 明確な supports でも entailment≈0.78 → 既定 0.75（0.8 では取りこぼす）
VITE_NLI_THRESHOLD=0.75
# Tier1 高精度: WebLLM（WebGPU必須・オプトイン ≈1GB→キャッシュ）
VITE_WEBLLM_MODEL=Qwen3-1.7B-q4f16_1-MLC
# lite の分類は低スペック端末を考慮して候補数を絞る
VITE_LINK_TOPK_LITE=3

# ===== サーバ専用（クライアントへ出さない / Vercel の環境変数に設定）=====
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5       # 実装時に公式ドキュメントで最新名・料金を確認
LLM_API_KEY=
LINK_CONFIDENCE_THRESHOLD=0.6

# pro のルーム単位LLM呼び出し上限（実装済み）。
# 有効化には下記2つも必要（未設定なら fail-open＝quota なしで従来動作）:
LLM_MAX_CALLS_PER_ROOM=400
SUPABASE_URL=                    # 例: https://xxxx.supabase.co（VITE_ 無し=サーバ専用）
SUPABASE_SERVICE_ROLE_KEY=       # Supabase Settings→API の service_role（絶対にクライアントへ出さない）
